[Desktop Entry]
Type=Application
Name=Speecher
Comment=Linux dictation popup
Exec=@SPEECHER_DESKTOP_EXEC@
Icon=io.github.firemonster612.speecher
StartupWMClass=speecher
Terminal=false
Categories=Utility;Accessibility;
Actions=ToggleDictation;Quit;

[Desktop Action ToggleDictation]
Name=Toggle Dictation
Exec=@SPEECHER_DESKTOP_EXEC@ toggle

[Desktop Action Quit]
Name=Quit
Exec=@SPEECHER_DESKTOP_EXEC@ quit
