// Windows names a tray app's notifications after FileDescription; without it
// they are headed "speecher.exe".
1 VERSIONINFO
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Speecher"
      VALUE "ProductName", "Speecher"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
