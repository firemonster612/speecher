+#ifndef _WIN32
+// Every device is destroyed in a handler registered after the driver's own
+// exit handlers, which therefore runs before them. Left to the end, a device
+// keeps the driver's worker threads running into the driver's teardown, which
+// can crash a process that finished its work. Each buffer type holds its
+// device, so no destructor ever does it. Windows runs these handlers under the
+// loader lock, where Vulkan calls can deadlock.
+static void ggml_vk_destroy_devices_at_exit() {
+    for (vk_device & device : vk_instance.devices) {
+        if (device) {
+            device->shutdown();
+        }
+    }
+}
+#endif
+
