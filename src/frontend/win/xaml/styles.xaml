<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Speecher's settings-card resources, keyed as in the Community Toolkit
       SettingsCard table (winui3-tech-notes.md section 6.4). Light, Dark and
       HighContrast dictionaries, no Default, so a theme change cannot leave a
       brush from the previous theme behind.

       The Light and Dark cards hold WinUI's CardBackgroundFillColorDefault and
       CardStrokeColorDefault values as literals, like the description text
       below. This dictionary is loaded with XamlReader into
       Application.Resources, where a StaticResource alias to those brushes
       resolved once against the application theme, the system's: on a light
       system the Dark dictionary got the Light fill (70% white), so a dark
       window drew light-grey cards under its white text. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="SettingsCardBackground" Color="#B3FFFFFF"/>
      <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#0F000000"/>
      <!-- TextFillColorSecondary's literal value: the brush is fetched from
           this dictionary in code by the window's ActualTheme, so it cannot
           alias a theme resource that resolves against the app theme. -->
      <SolidColorBrush x:Key="SettingsCardDescriptionForeground" Color="#9E000000"/>
      <!-- TextFillColorDisabled: a row's words beside a disabled control. -->
      <SolidColorBrush x:Key="SettingsCardDisabledForeground" Color="#5C000000"/>
      <!-- Model rating badges: WinUI's AccentFillColorDefault,
           SystemFillColorCritical and SystemFillColorNeutral for this theme. -->
      <SolidColorBrush x:Key="RatingBadgeAccent" Color="{ThemeResource SystemAccentColorDark1}"/>
      <SolidColorBrush x:Key="RatingBadgeCritical" Color="#C42B1C"/>
      <SolidColorBrush x:Key="RatingBadgeNeutral" Color="#72000000"/>
      <!-- SystemFillColorSuccess and SystemFillColorCritical: text that
           reports a good or a failed outcome. -->
      <SolidColorBrush x:Key="PositiveTextForeground" Color="#0F7B0F"/>
      <SolidColorBrush x:Key="NegativeTextForeground" Color="#C42B1C"/>
      <!-- SolidBackgroundFillColorBase: the opaque window colour behind the
           card in the copied stats image, which has no Mica to show. -->
      <SolidColorBrush x:Key="StatsImageBackground" Color="#F3F3F3"/>
      <!-- SystemFillColorCaution: a paused dictation's waveform and status. -->
      <SolidColorBrush x:Key="PausedForeground" Color="#9D5D00"/>
      <!-- TextOnAccentFillColorSecondary: the key named beside the caption
           on the dictation popup's accent button. -->
      <SolidColorBrush x:Key="AccentButtonSecondaryForeground" Color="#B3FFFFFF"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="SettingsCardBackground" Color="#0DFFFFFF"/>
      <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#19000000"/>
      <SolidColorBrush x:Key="SettingsCardDescriptionForeground" Color="#C5FFFFFF"/>
      <SolidColorBrush x:Key="SettingsCardDisabledForeground" Color="#5DFFFFFF"/>
      <SolidColorBrush x:Key="RatingBadgeAccent" Color="{ThemeResource SystemAccentColorLight2}"/>
      <SolidColorBrush x:Key="RatingBadgeCritical" Color="#FF99A4"/>
      <SolidColorBrush x:Key="RatingBadgeNeutral" Color="#8BFFFFFF"/>
      <SolidColorBrush x:Key="PositiveTextForeground" Color="#6CCB5F"/>
      <SolidColorBrush x:Key="NegativeTextForeground" Color="#FF99A4"/>
      <SolidColorBrush x:Key="StatsImageBackground" Color="#202020"/>
      <SolidColorBrush x:Key="PausedForeground" Color="#FCE100"/>
      <SolidColorBrush x:Key="AccentButtonSecondaryForeground" Color="#80000000"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="SettingsCardBackground" Color="{ThemeResource SystemColorButtonFaceColor}"/>
      <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="SettingsCardDescriptionForeground" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="SettingsCardDisabledForeground" Color="{ThemeResource SystemColorGrayTextColor}"/>
      <SolidColorBrush x:Key="RatingBadgeAccent" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="RatingBadgeCritical" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="RatingBadgeNeutral" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="PositiveTextForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="NegativeTextForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="StatsImageBackground" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="PausedForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="AccentButtonSecondaryForeground" Color="{ThemeResource SystemColorHighlightTextColor}"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Thickness x:Key="SettingsCardBorderThickness">1</Thickness>
  <Thickness x:Key="SettingsCardPadding">16,16,16,16</Thickness>
  <x:Double x:Key="SettingsCardMinHeight">68</x:Double>
  <x:Double x:Key="SettingsCardHeaderIconMaxSize">20</x:Double>
  <x:Double x:Key="SettingsCardContentMinWidth">120</x:Double>
  <x:Double x:Key="SettingsCardSpacing">4</x:Double>
  <x:Double x:Key="SettingsPageMaxWidth">1064</x:Double>

  <!-- WinUI Gallery's settings page type: TitleTextBlockStyle page title,
       BodyStrong section headers with Margin 1,30,0,6, Caption footnotes. -->
  <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock"
         BasedOn="{StaticResource TitleTextBlockStyle}">
    <Setter Property="Margin" Value="0,24,0,0"/>
  </Style>
  <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock"
         BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="Margin" Value="1,30,0,6"/>
  </Style>
  <!-- No Foreground setters here: a Style setter's ThemeResource resolves once
       at application scope, so a window whose RequestedTheme differs from the
       system's would keep the wrong brush. Elements set it themselves. -->
  <Style x:Key="SettingsFootnoteStyle" TargetType="TextBlock"
         BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Margin" Value="1,6,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="SettingsCardBodyStyle" TargetType="TextBlock"
         BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="SettingsCardDescriptionStyle" TargetType="TextBlock"
         BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- An Info row's value: body-sized secondary text on the card's right. -->
  <Style x:Key="SettingsInfoTextStyle" TargetType="TextBlock"
         BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

</ResourceDictionary>
